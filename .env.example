# ---- Site --------------------------------------------------------------
# Canonical origin for links, sitemap and share cards. Defaults to
# https://boutique-travel.vercel.app; set it when a custom domain goes live.
NEXT_PUBLIC_SITE_URL=

# Google Search Console → Add property → URL prefix → "HTML tag": paste only
# the content="..." value here.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (G-XXXXXXX). Loads only after the
# visitor accepts the cookie notice.
NEXT_PUBLIC_GA_ID=

# Set to 1 to keep a deployment out of search results. Vercel preview
# deployments are always noindex.
NEXT_PUBLIC_NOINDEX=

# ---- Enquiry + Field Notes email (Resend, https://resend.com) -----------
# Server-only. NEVER prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
# Where enquiries are delivered; comma-separate several addresses.
ENQUIRY_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Backroad Ledger <journeys@yourdomain.com>".
# Leave empty to use Resend's test sender (delivers only to the Resend account's own email).
RESEND_FROM_EMAIL=
# Optional: a Resend audience ID. Field Notes sign-ups are added there;
# without it, each sign-up is emailed to ENQUIRY_TO_EMAIL instead.
RESEND_AUDIENCE_ID=
